# QQ Bot 配置

# WebSocket 服务器端口
ONEBOT_PORT=3002

# 访问令牌（可选，与 NapCat 配置一致）
ONEBOT_TOKEN=

# 允许回复的群号白名单（逗号分隔，空表示不限制）
ALLOWED_GROUP_IDS=

# Claude 工作目录
CLAUDE_WORKING_DIR=/Users/mac/knowledge1

# 回复中显示的模型标识（可选）
CLAUDE_MODEL_LABEL=Claude CLI

# Claude 三层模型链（留空表示跳过该层）
CLAUDE_MODEL_PRIMARY=
CLAUDE_MODEL_SECONDARY=
# 第三层留空则使用 Claude CLI 默认模型
CLAUDE_MODEL_TERTIARY=

# Claude 候选模型列表（逗号或换行分隔，按顺序尝试；配置后优先于上面三项）
# CLAUDE_MODEL_CANDIDATES=Qwen/Qwen3-Coder-480B-A35B-Instruct,MiniMax/MiniMax-M1-80k,Qwen/Qwen3-Coder-480B-A35B-Instruct,Qwen/Qwen3-235B-A22B-Instruct-2507,Qwen/Qwen3-235B-A22B-Thinking-2507,deepseek-chat,deepseek-reasoner,deepseek-chat-search,deepseek-ai/DeepSeek-R1-0528

# ============== Dify API 配置 ==============
# Dify API 基础地址
DIFY_API_BASE_URL=http://100.78.159.78/v1

# 法规知识库 API Key（用于 /法规 命令）
# 与 gmp-ai-assistant 项目共用，可使用以下任一变量名：
# DIFY_REGULATIONS_QA_API_KEY（推荐，与 gmp-ai-assistant 一致）
# DIFY_REGULATIONS_API_KEY（兼容旧配置）
DIFY_REGULATIONS_QA_API_KEY=

# 药典知识库 API Key（用于 /药典 命令）
# 与 gmp-ai-assistant 项目共用，可使用以下任一变量名：
# DIFY_PHARMACOPOEIA_QA_API_KEY（推荐，与 gmp-ai-assistant 一致）
# DIFY_PHARMACOPOEIA_API_KEY（兼容旧配置）
DIFY_PHARMACOPOEIA_QA_API_KEY=
